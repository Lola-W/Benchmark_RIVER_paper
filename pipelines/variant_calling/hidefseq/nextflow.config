// nextflow.config

// Global process settings
process {
    // Use Slurm as the executor
    executor = 'slurm'
    // Define default resources
    cpus = 18
    memory = '126 GB'
    time = '168h'
    // Specify the queue/partition to use]
    // queue = 'your_partition'
    // Additional Slurm options not covered by the above, such as node count and output log file
    // Add account/QOS options required by your Slurm cluster here.
    // Load Singularity in the submitting environment.
    // Override resources for filterCalls step(s)
    // withName: 'filterCallsChunkChromgroupFiltergroup.*' {
    //     cpus   = 24      // fewer cores so each gets more RAM
    //     memory = '192 GB' // dedicated to this heavy step
    //     time   = '168h'
    // }
    withName: 'makeBarcodesFasta' {
        cpus   = 12      
        memory = '96 GB'
        time   = '168h'
    }
    withName: 'calculateBurdensChromgroupFiltergroup.*' {
        cpus   = 24      // fewer cores so each gets more RAM
        memory = '192 GB' // dedicated to this heavy step
        time   = '168h'
        maxRetries  = 3 
    }
    withName: 'outputResultsSample' {
        cpus   = 24      // fewer cores so each gets more RAM
        memory = '192 GB' // dedicated to this heavy step
        time   = '168h'
    }
    errorStrategy = 'retry'
}

singularity {
    enabled     = true
    autoMounts  = true
    runOptions = "--bind ${launchDir}/.."
}




